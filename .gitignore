# Merged dataset — rebuild with: python scripts/build_dataset.py
dataset/

# Harvested images — refetch with: python scripts/harvest_images.py
# attribution.csv IS tracked: it is the licence record for everything harvested.
harvest/images/
harvest/rejected/
harvest/prelabelled/

# Training outputs and pretrained checkpoints
runs/
weights/
*.pt
*.log

__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/

# Abstain training set — rebuild with: python scripts/build_abstain_dataset.py
dataset_abstain/

# Rendered prediction samples — regenerate with: python scripts/show_predictions.py
samples/

# Merged ouo_final dataset — rebuild with: python scripts/build_dataset_ouo.py
dataset_v2/

# Source collection for dataset_v2 (828 MB) — kept local, not tracked.
# See README: the repo is already ~700 MB and provenance is unresolved.
ouo_final/

# Ingredient-level dataset — rebuild with: python scripts/build_dataset_ouo.py --level ingredient
dataset_ing/

# Brand-family dataset — rebuild with: python scripts/build_dataset_ouo.py --level family
dataset_fam/

# Hand-corrected labels from scripts/label_viewer.py — human work, tracked on purpose.
!label_fixes/

# staged from ouo_final by scripts/build_conflict_todo.py; rebuild it instead of tracking it
dataset_todo/
